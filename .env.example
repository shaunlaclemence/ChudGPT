# Copy to .env (gitignored) or export in your shell. Set the ones you have —
# any subset works; the rotor only uses providers with a key present.
# Comma-separate multiple keys for one provider (see README ToS note first).

GEMINI_API_KEY=        # https://aistudio.google.com/apikey
GROQ_API_KEY=          # https://console.groq.com/keys
MISTRAL_API_KEY=       # https://console.mistral.ai/api-keys
XAI_API_KEY=           # https://console.x.ai
OPENROUTER_API_KEY=    # https://openrouter.ai/keys

# Optional: override where daily quota state is stored (default ~/.chudgpt/state.json)
# CHUDGPT_STATE=
